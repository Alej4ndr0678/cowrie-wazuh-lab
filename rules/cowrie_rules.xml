<group name="cowrie,honeypot,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid" type="pcre2">^cowrie\.</field>
    <description>Cowrie: evento del honeypot.</description>
  </rule>
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.session\.connect$</field>
    <description>Cowrie: conexión desde $(src_ip).</description>
  </rule>
  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.failed$</field>
    <description>Cowrie: acceso fallido de $(username) desde $(src_ip).</description>
  </rule>
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.login\.success$</field>
    <description>Cowrie: acceso aceptado en el honeypot para $(username) desde $(src_ip).</description>
  </rule>
  <rule id="100104" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid" type="pcre2">^cowrie\.command\.input$</field>
    <description>Cowrie: comando registrado: $(input).</description>
  </rule>
</group>
