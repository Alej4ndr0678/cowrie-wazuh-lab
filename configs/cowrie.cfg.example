# Fragmento para fusionar con etc/cowrie.cfg; evitar secciones duplicadas.
# Valores comprobados en el laboratorio; fusionar con la configuración completa.
[honeypot]
hostname = svr04
backend = shell

[ssh]
enabled = true
listen_endpoints = tcp:2222:interface=192.168.50.20
forwarding = false

[telnet]
enabled = false

[output_jsonlog]
enabled = true
logfile = ${honeypot:log_path}/cowrie.json
